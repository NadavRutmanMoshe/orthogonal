# Generated by `node ../tools/build-app.js --desktop` - a copy of the game,
# like app/www, and a copy is exactly the thing that goes stale.
www/
# electron-builder's output: the folder SteamPipe uploads.
dist/
node_modules/
# steampipe.js writes app_build.vdf from steam.json, and SteamCMD writes
# its logs and manifests beside it.
steampipe/
