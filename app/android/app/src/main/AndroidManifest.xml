<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ADMOB. The app id is REQUIRED - without it the ad SDK crashes the
             app on launch. This one is Google's public TEST app id, paired
             with AD_TEST=true in js/24-ads.js; the real one comes from the
             AdMob dashboard and replaces it when that switch goes false.
             Note the app id has a "~" and an ad UNIT id has a "/". -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
        <!-- SEND NOTHING UNTIL THE GAME SAYS SO. By default the SDK starts
             measuring the moment the app opens, before anybody has answered
             how old they are. This holds it until initialize(), which
             js/24-ads.js calls only once the age band is known, with the
             child flags set. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true"/>

        <!-- PORTRAIT, LOCKED, on the owner's call after looking at it on a real
             phone. Landscape was never designed: the level, the home screen and
             the panels are all laid out down a tall screen, and sideways every
             one of them is wrong. An orientation nobody has designed for is not
             a feature you leave switched on because the activity can survive
             the rotation. configChanges keeps handling the rest. -->
        <activity
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
