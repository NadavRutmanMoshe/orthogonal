<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup="true" IS THE PROGRESS BACKUP. Android copies the app's
         data - the WebView's localStorage, which holds every orthogonal:*
         key, so levels, stars, wardrobe and settings - into the player's own
         Google account, and puts it back when the game is reinstalled from
         Play or a new phone is set up. Proven on a device on 22 Sep: forced
         backup, uninstall, reinstall, and the save came back (docs/HISTORY.md).
         No code does this and none is needed. Setting it false for "privacy"
         silently loses every player's progress on a reinstall, and
         docs/privacy.html section 1 and STORE-ANSWERS.md both describe it -
         change all three together or none. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ADMOB. The app id is REQUIRED - without it the ad SDK crashes the
             app on launch. THIS IS THE REAL ONE, from the AdMob dashboard
             (an app id carries "~"; an ad UNIT id carries "/").

             The real app id sits happily beside TEST ad units, which is what
             AD_TEST=true in js/24-ads.js still serves and will keep serving
             through the closed test: the app id names the account, the unit
             id decides whether an impression is real. So there is no live
             ad to tap by accident, and nothing here changes when the switch
             finally goes false. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6542623981022877~5232560580"/>
        <!-- SEND NOTHING UNTIL THE GAME SAYS SO. By default the SDK starts
             measuring the moment the app opens, before anybody has answered
             how old they are. This holds it until initialize(), which
             js/24-ads.js calls only once the age band is known, with the
             child flags set. -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true"/>

        <!-- PLAY GAMES, for the achievements (AchievementsPlugin.java). The
             id is the number Play Console shows for the Games Services
             project, and it lives in res/values/strings.xml; while that is
             empty the plugin never starts the SDK and every achievement
             call answers "no".

             THE SDK'S OWN START-UP IS REMOVED. PlayGamesInitProvider starts
             Play Games at launch whether or not there is an id, and with no
             id that is the "fatal developer error" crash. The plugin starts
             it by hand instead, and only when the id is there. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id"/>
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            android:authorities="${applicationId}.playgamesinitprovider"
            tools:node="remove"/>

        <!-- PORTRAIT, LOCKED, on the owner's call after looking at it on a real
             phone. Landscape was never designed: the level, the home screen and
             the panels are all laid out down a tall screen, and sideways every
             one of them is wrong. An orientation nobody has designed for is not
             a feature you leave switched on because the activity can survive
             the rotation. configChanges keeps handling the rest. -->
        <activity
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
