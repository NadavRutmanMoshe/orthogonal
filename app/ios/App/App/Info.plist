	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<!-- PORTRAIT, LOCKED, ON BOTH FAMILIES. The same call as Android: the
	     level, the home screen and the panels are all laid out down a tall
	     screen. UIRequiresFullScreen is what MAKES that legal on iPad -
	     without it Apple demands all four orientations for multitasking, and
	     the app is rejected. Upside-down is allowed on iPad only, where it is
	     just "which way up you are holding it". -->
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- THE GAME USES NO ENCRYPTION OF ITS OWN, and https is exempt. Saying so
	     here answers the export-compliance question once instead of on every
	     single TestFlight upload, which is otherwise a manual click before a
	     build can reach a tester. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- AdMob. The app id has a ~ and the ad unit ids have a / - swapping one
	     for the other is the classic crash. Missing entirely, the SDK takes
	     the app down ON LAUNCH, before an ad is ever asked for, exactly as on
	     Android. This is the real iOS app id; AD_TEST in js/24-ads.js is what
	     keeps the UNITS on Google test ids. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-6542623981022877~4214992380</string>
	<!-- Nothing is sent until the game calls initialize(), which it only does
	     once the age band is known (js/24-ads.js, adBoot/applyAgeBand). -->
	<key>GADDelayAppMeasurementInit</key>
	<true/>
	<!-- NO NSUserTrackingUsageDescription, deliberately. The game never shows
	     the ATT prompt and every iOS player gets non-personalised ads
	     (adNoTrack(), docs/STORE-ANSWERS.md). An app that declares a reason
	     for asking and then never asks is a question at review. -->
