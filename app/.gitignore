# The web root is generated by tools/build-app.js from the repository root.
# Committing it would be committing a second copy of the whole game, and a
# copy is exactly the thing that goes stale.
www/

# Capacitor writes this one from capacitor.config.json on every sync.
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/public/
